# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored by Next.js's default template — never commit real secrets.

# Your own secret, made up by you (any random string works, e.g. run
# `openssl rand -hex 16`). Paste it as a query param on the webhook URL you
# register in the Cakto dashboard: https://your-domain.com/api/cakto/webhook?token=THIS_VALUE
# Cakto's own webhook signing isn't clearly documented, so this app checks
# this token itself instead of trusting an unconfirmed mechanism.
CAKTO_WEBHOOK_TOKEN=

# Orders are stored in a local SQLite file at data/orders.db — created
# automatically on first run, nothing to configure. NOTE: this only
# persists on a host with a durable filesystem (a VPS, Docker volume,
# running locally). On serverless platforms like Vercel the filesystem is
# ephemeral and orders would be lost between deploys/cold starts — swap
# to a hosted SQLite (e.g. Turso) or Postgres before deploying there.
