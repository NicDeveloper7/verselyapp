# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored by Next.js's default template — never commit real secrets.

# Your own secret, made up by you (any random string works, e.g. run
# `openssl rand -hex 16`). Paste it as a query param on the webhook URL you
# register in the Cakto dashboard: https://your-domain.com/api/cakto/webhook?token=THIS_VALUE
# Cakto's own webhook signing isn't clearly documented, so this app checks
# this token itself instead of trusting an unconfirmed mechanism.
CAKTO_WEBHOOK_TOKEN=

# Orders database. Leave both blank for local dev — it falls back to an
# embedded SQLite file at data/orders.db automatically, no setup needed.
# Fill these in for Vercel (or any serverless host) — their filesystem is
# ephemeral, so a local file would silently lose every order. Get these
# from turso.tech (free tier): `turso db create versely` then
# `turso db show versely --url` and `turso db tokens create versely`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password for /admin — a simple order-viewing panel (no signup, just this
# one shared password). Make up any string. Without this set, /admin always
# shows the login form and never grants access, even with the right guess.
ADMIN_PASSWORD=
